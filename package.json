{
  "name": "colorful-life-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently --kill-others --names renderer,electron-build,electron \"npm:dev:renderer\" \"npm:dev:electron:compile\" \"npm:dev:electron:launch\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron:compile": "run-s build:electron:assets dev:electron:watch",
    "dev:electron:watch": "tsc -p tsconfig.electron.json --watch",
    "dev:electron:launch": "run-s dev:electron:wait dev:electron:run",
    "dev:electron:wait": "wait-on http://127.0.0.1:5173 dist-electron/main.js",
    "dev:electron:run": "cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .",
    "build": "run-s typecheck build:renderer build:electron",
    "typecheck": "tsc -b",
    "build:renderer": "run-s build:renderer:vite verify:renderer-build",
    "build:renderer:vite": "vite build",
    "verify:renderer-build": "node scripts/verify-renderer-build.mjs",
    "build:electron": "run-s build:electron:tsc build:electron:assets",
    "build:electron:tsc": "tsc -p tsconfig.electron.json",
    "build:electron:assets": "node scripts/copy-electron-assets.mjs",
    "electron": "electron .",
    "test": "run-s test:unit build test:electron-boundary test:electron-runtime test:orders-runtime test:inventory-runtime test:security-runtime test:development-runtime",
    "test:unit": "vitest run",
    "test:electron-boundary": "node scripts/verify-electron-boundary.mjs",
    "test:electron-runtime": "electron scripts/verify-purchase-runtime.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:orders-runtime": "electron scripts/verify-order-runtime.mjs",
    "test:security-runtime": "electron scripts/verify-security-runtime.mjs",
    "test:development-runtime": "node scripts/verify-development-runtime.mjs",
    "test:inventory-runtime": "electron scripts/verify-inventory-runtime.mjs",
    "package": "run-s build package:create",
    "package:create": "node scripts/package.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "test:contracts": "node scripts/verify-shared-contract.mjs",
    "dev:sandbox": "cross-env COLORFUL_LIFE_CONNECTION_MODE=remote-sandbox npm run dev",
    "electron:sandbox": "run-s build electron:sandbox:launch",
    "electron:sandbox:launch": "cross-env COLORFUL_LIFE_CONNECTION_MODE=remote-sandbox electron ."
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@electron/packager": "20.3.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wait-on": "^9.1.0"
  }
}
